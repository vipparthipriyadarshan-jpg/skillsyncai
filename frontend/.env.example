# Skill Sync AI - Environment Variables Template
# Copy this file to .env.local and populate with your credentials

# Supabase Cloud Platform Credentials (Required for Auth & Postgres DB)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Supabase Service Role Key (Used for server-side admin operations)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Python Analytics & AI Microservice URL (FastAPI)
NEXT_PUBLIC_ANALYTICS_SERVICE_URL=http://localhost:8000

# Groq API Key (Used in Python microservice for Llama-3 extraction)
# GROQ_API_KEY=gsk_your_groq_api_key
